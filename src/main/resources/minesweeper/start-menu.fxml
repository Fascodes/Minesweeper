<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="minesweeper.StartMenuController" alignment="CENTER">
    <children>
        <Label text="Minesweeper" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <VBox spacing="15.0" alignment="CENTER">
            <VBox.margin>
                <Insets top="20.0" />
            </VBox.margin>

            <VBox spacing="5.0" alignment="CENTER">
                <Label text="Wielkość planszy:" />
                <ComboBox fx:id="boardSizeComboBox" prefWidth="200.0" />
            </VBox>

            <VBox spacing="5.0" alignment="CENTER">
                <Label text="Poziom trudności:" />
                <ComboBox fx:id="difficultyComboBox" prefWidth="200.0" />
            </VBox>

            <VBox spacing="5.0" alignment="CENTER">
                <Label text="Rozmiar pola:" />
                <ComboBox fx:id="cellSizeComboBox" prefWidth="200.0" />
            </VBox>

            <Button fx:id="startGameButton" onAction="#onStartGameClick" text="Rozpocznij grę" prefWidth="200.0" style="-fx-font-size: 14px;">
                <VBox.margin>
                    <Insets top="20.0" />
                </VBox.margin>
            </Button>
        </VBox>
    </children>
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
</VBox>